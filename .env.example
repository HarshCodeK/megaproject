# Optional — enables agent (online) mode. Without it, the OS runs in
# RAG-only offline mode and still serves answers.
GROQ_API_KEY=

# Overrides (all optional)
# Live models on the developer tier, checked 2026-10-02:
#   qwen/qwen3.8-27b      (default — tool use, JSON mode, vision)
#   openai/gpt-oss-120b   (cheapest production-grade text)
#   openai/gpt-oss-20b    (fastest)
# MP_LLM_MODEL=qwen/qwen3.8-27b
# MP_DB=megaproject.db
# MP_CHROMA=chroma_db
# MP_DOCS=knowledge_docs
